{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Desktop Canvas",
  "version": "0.1.0",
  "identifier": "com.desktopcanvas.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop Canvas",
        "label": "main",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "center": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": true,
        "focus": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
